# Copy this file to .env and insert your Yahoo application Client ID.
YAHOO_CLIENT_ID=replace-with-your-client-id
YAHOO_REDIRECT_URI=https://localhost:8787/oauth/callback
PORT=8787

# Local HTTPS certificate files. Never commit the private key.
TLS_CERT_PATH=certs/localhost-cert.pem
TLS_KEY_PATH=certs/localhost-key.pem
